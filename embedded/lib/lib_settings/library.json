{
    "name": "lib_settings",
    "version": "1.0.0",
    "description": "LeoIoT Settings Library",
    "keywords": ["LeoIoT", "settings", "saving"],
    "includeDir": "include",
    "srcDir": "src",
    "frameworks": ["arduino"],
    "dependencies": [
        {
            "owner": "bblanchon",
            "name": "ArduinoJson",
            "version": "^7.0.4",
